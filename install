#!/usr/bin/env ruby

# from http://errtheblog.com/posts/89-huba-huba

home = File.expand_path('~')

Dir['*'].each do |file|
  next if file =~ /install/
  next if file =~ /README.md/
  next if file =~ /custom/
  next if file =~ /Tech Notes/
  next if file =~ /other_config/
  next if file =~ /include_d/
  next if file =~ /bash-preexec.sh/
  next if file =~ /nvim/
  target = File.join(home, ".#{file}")
  `ln -sn #{File.expand_path file} #{target}`
end

`mkdir -p #{home}/.config`
`ln -sn #{File.expand_path 'nvim'} #{home}/.config/nvim`

target = File.join(home, "TechNotes")
`ln -s "TechNotes" #{target}`

# git push on commit
`echo 'git push' > .git/hooks/post-commit`
`chmod 755 .git/hooks/post-commit`
