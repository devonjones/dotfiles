#!/usr/bin/env ruby

# from http://errtheblog.com/posts/89-huba-huba

home = File.expand_path('~')
Dir.chdir(__dir__)

# tracked entries only, so stray untracked dirs never get linked
`git ls-tree --name-only HEAD`.split("\n").reject { |f| f.start_with?('.') }.each do |file|
  next if file =~ /install/
  next if file =~ /README.md/
  next if file =~ /custom/
  next if file =~ /other_config/
  next if file =~ /include_d/
  next if file =~ /bash-preexec.sh/
  next if file =~ /claude/
  next if file =~ /nvim/
  target = File.join(home, ".#{file}")
  `ln -sn #{File.expand_path file} #{target}`
end

`mkdir -p #{home}/.config`
`ln -sn #{File.expand_path 'nvim'} #{home}/.config/nvim`
`mkdir -p #{home}/.claude`
`ln -sn #{File.expand_path 'claude/CLAUDE.md'} #{home}/.claude/CLAUDE.md`

# per-employer claude rules, resolved the same way as include_d
employer = `[ -e #{home}/.employer ] && . #{home}/.employer; echo "${EMPLOYER:-Personal}"`.strip
`mkdir -p #{home}/.claude/rules`
Dir["claude/#{employer}/*.md"].each do |rule|
  `ln -sn #{File.expand_path rule} #{home}/.claude/rules/#{File.basename rule}`
end

# git push on commit
`echo 'git push' > .git/hooks/post-commit`
`chmod 755 .git/hooks/post-commit`
